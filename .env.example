# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DATABASE_URL="postgresql://usuario:senha@localhost:5432/intelisensor"

# ==============================================
# JWT CONFIGURATION
# ==============================================
JWT_SECRET="sua-chave-secreta-jwt-muito-segura-altere-em-producao"
JWT_EXPIRES_IN="7d"

# ==============================================
# REDIS CONFIGURATION (BullMQ)
# ==============================================
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD="sua-senha-redis"

# ==============================================
# AWS S3 CONFIGURATION
# ==============================================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="sua-aws-access-key"
AWS_SECRET_ACCESS_KEY="sua-aws-secret-access-key"
AWS_S3_BUCKET="nome-do-seu-bucket-s3"

# ==============================================
# TWILIO CONFIGURATION (SMS/Voice)
# ==============================================
TWILIO_ACCOUNT_SID="seu-twilio-account-sid"
TWILIO_AUTH_TOKEN="seu-twilio-auth-token"
TWILIO_PHONE_NUMBER="+5511999999999"

# ==============================================
# EMAIL CONFIGURATION
# Escolha um dos provedores abaixo e configure
# ==============================================

# Opção 1: Mailgun
MAILGUN_API_KEY="sua-mailgun-api-key"
MAILGUN_DOMAIN="seu-dominio.mailgun.org"

# Opção 2: Resend
RESEND_API_KEY="sua-resend-api-key"

# Opção 3: SMTP Genérico (Gmail, Outlook, etc)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-ou-app-password"
SMTP_FROM="noreply@seudominio.com"

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
PORT=3002
NODE_ENV="development"

# ==============================================
# WHATSAPP CONFIGURATION (Opcional)
# ==============================================
# Deixe vazio se não for usar integração WhatsApp
WHATSAPP_SESSION_PATH="./baileys_auth"

# ==============================================
# NOTIFICATION SETTINGS
# ==============================================
# Tempo em minutos para deadline de verificação de alertas
ALERT_VERIFICATION_DEADLINE_MINUTES=10

# ==============================================
# SECURITY SETTINGS
# ==============================================
# Salt rounds para bcrypt (10-12 recomendado)
BCRYPT_SALT_ROUNDS=10

# Tempo de expiração de códigos de acesso em minutos
ACCESS_CODE_EXPIRATION_MINUTES=60

# Máximo de tentativas de uso de código
MAX_CODE_ATTEMPTS=5
