    "uuid": "^13.0.0",
    "whaileys": "^6.2.6",
    "whatsapp-web.js": "^1.34.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.8",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
