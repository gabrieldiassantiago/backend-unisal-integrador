generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDECLARED
}

model User {
  id              String   @id @default(uuid())
  name            String
  birthDate       DateTime?
  email           String?  @unique
  password        String?
  role            Role
  hasAccount      Boolean  @default(false)
  emailVerified   Boolean  @default(true)
  createdAt       DateTime @default(now())
  gender          Gender?
  currentSessionId String?
  phone     String?  
  
  devices       Device[]
  contacts      EmergencyContact[]
  patients      CaregiverPatient[] @relation("CaregiverPatients")
  caregivers    CaregiverPatient[] @relation("PatientCaregivers")
  fallAlerts    FallAlert[]        @relation("FallAlertPatient")

  issuedCodes   AccessCode[] @relation("IssuedByCaregiver")
  loginCodes    AccessCode[] @relation("LoginForPatient")

  refreshTokens RefreshToken[]

  respondedAlerts FallAlert[] @relation("AlertRespondedBy")

  pushTokens PushToken[]

  primaryCaregiverRelations FamilyRelation[] @relation("PrimaryCaregiverRelations")
  familyMemberRelations     FamilyRelation[] @relation("FamilyMemberRelations") 
  patientFamilyRelations    FamilyRelation[] @relation("PatientFamilyRelations")

  @@index([role])
}

model Device {
  id               String   @id @default(uuid())
  deviceIdentifier String   @unique
  apiKeyHash       String
  status           DeviceStatus @default(ACTIVE)
  
  pairingDigest    String?   @unique
  pairingExpiresAt DateTime?
  pairedAt         DateTime?

  lastSeenAt       DateTime?
  firmwareVersion  String?
  
  isOnline         Boolean  @default(false)
  batteryLevel     Int?
  signalStrength   Int?
  lastHeartbeatAt  DateTime?
  ipAddress        String?

  patientId        String?
  patient          User?      @relation(fields: [patientId], references: [id])
  registeredAt     DateTime @default(now())

  fallAlerts       FallAlert[] @relation("FallAlertDevice")

  @@index([patientId])
  @@index([isOnline])
}

model EmergencyContact {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  patientId String
  patient   User     @relation(fields: [patientId], references: [id])

  confirmedAlerts FallAlert[] @relation("FallAlertConfirmedBy")

  priority  Int      @default(1)
}

model CaregiverPatient {
  id          String   @id @default(uuid())
  caregiverId String
  patientId   String
  createdAt   DateTime @default(now())

  caregiver User @relation("CaregiverPatients", fields: [caregiverId], references: [id])
  patient   User @relation("PatientCaregivers", fields: [patientId], references: [id])

  @@unique([caregiverId, patientId])
  @@index([patientId])
}

model FallAlert {
  id           String   @id @default(uuid())
  deviceId     String
  patientId    String

  device       Device   @relation("FallAlertDevice", fields: [deviceId], references: [id])
  patient      User     @relation("FallAlertPatient", fields: [patientId], references: [id])

  status       FallStatus
  latitude     Float
  longitude    Float
  createdAt    DateTime @default(now())
  confirmedAt  DateTime?
  location     String?

  confirmedByContactId String?
  confirmedBy          EmergencyContact? @relation("FallAlertConfirmedBy", fields: [confirmedByContactId], references: [id])

  confirmationMethod   ConfirmationMethod?

  respondedBy          String?
  responder            User?    @relation("AlertRespondedBy", fields: [respondedBy], references: [id])
  respondedAt          DateTime?
  verificationDeadline DateTime?

  @@index([patientId, createdAt])
  @@index([respondedBy])
}

model AccessCode {
  id            String   @id @default(uuid())

  codeDigest    String   @unique
  codeHash      String
  codeDisplay   String
  type          CodeType @default(LOGIN_PATIENT)

  caregiverId   String
  caregiver     User     @relation("IssuedByCaregiver", fields: [caregiverId], references: [id])

  patientId     String
  patient       User     @relation("LoginForPatient", fields: [patientId], references: [id])

  familyEmail   String?
  familyName    String?

  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  revokedById   String?

  maxUses       Int      @default(1)
  uses          Int      @default(0)
  attempts      Int      @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime @default(now())

  @@index([caregiverId])
  @@index([patientId])
  @@index([expiresAt])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  deviceId   String?
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

model FamilyRelation {
  id                 String   @id @default(uuid())
  primaryCaregiverId String
  familyMemberId     String
  patientId          String
  
  primaryCaregiver   User     @relation("PrimaryCaregiverRelations", fields: [primaryCaregiverId], references: [id])
  familyMember       User     @relation("FamilyMemberRelations", fields: [familyMemberId], references: [id])
  patient            User     @relation("PatientFamilyRelations", fields: [patientId], references: [id])
  
  permissions        FamilyPermissions?
  invitedAt          DateTime @default(now())
  acceptedAt         DateTime?
  revokedAt          DateTime?
  
  @@unique([primaryCaregiverId, familyMemberId, patientId])
  @@index([patientId])
  @@index([familyMemberId])
}

model FamilyPermissions {
  id                String   @id @default(uuid())
  relationId        String   @unique
  relation          FamilyRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  
  canViewAlerts       Boolean @default(true)
  canRespondAlerts    Boolean @default(false)
  canViewProfile      Boolean @default(true)
  canEditProfile      Boolean @default(false)
  canManageContacts   Boolean @default(false)
  canInviteFamily     Boolean @default(false)
}

enum Role {
  PATIENT
  CAREGIVER
  FAMILY_MEMBER
}

enum FallStatus {
  PENDING
  VERIFYING
  FALSE_ALARM
  CONFIRMED
  IGNORED
  RESOLVED
}

enum ConfirmationMethod {
  WHATSAPP
  APP
  CALL
  OTHER
}

enum CodeType {
  LOGIN_PATIENT
  DEVICE_PAIRING
  FAMILY_INVITE
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE 
  REVOKED
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model EmailVerification {
  id          String   @id @default(uuid())
  email       String
  code        String
  verified    Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  verifiedAt  DateTime?
  attempts    Int      @default(0)
  
  tempUserData Json?

  @@index([email])
  @@index([code])
}
