// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://intelisensor:intelisensor@167.99.57.166:5432/intelisensor"
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDECLARED
}

// =================== MODELS ===================

model User {
  id         String   @id @default(uuid())
  name       String
  birthDate  DateTime?
  email      String?  @unique
  password   String?
  role       Role
  hasAccount Boolean  @default(false)
  createdAt  DateTime @default(now())
  gender     Gender?

  // relações
  devices       Device[]
  contacts      EmergencyContact[]
  patients      CaregiverPatient[] @relation("CaregiverPatients")
  caregivers    CaregiverPatient[] @relation("PatientCaregivers")
  fallAlerts    FallAlert[]        @relation("FallAlertPatient")

  // access codes
  issuedCodes   AccessCode[] @relation("IssuedByCaregiver")
  loginCodes    AccessCode[] @relation("LoginForPatient")

  // sessões
  refreshTokens RefreshToken[]

  // 🆕 alertas respondidos por este cuidador
  respondedAlerts FallAlert[] @relation("AlertRespondedBy")

  // 🆕 relações familiares
  primaryCaregiverRelations FamilyRelation[] @relation("PrimaryCaregiverRelations")
  familyMemberRelations     FamilyRelation[] @relation("FamilyMemberRelations") 
  patientFamilyRelations    FamilyRelation[] @relation("PatientFamilyRelations")

  @@index([role])
}

model Device {
  id               String   @id @default(uuid())
  deviceIdentifier String   @unique
  apiKeyHash       String
  status           DeviceStatus @default(ACTIVE)
  
  pairingDigest    String?   @unique
  pairingExpiresAt DateTime?
  pairedAt         DateTime?

  lastSeenAt       DateTime?
  firmwareVersion  String?

  patientId        String?
  patient          User?      @relation(fields: [patientId], references: [id])
  registeredAt     DateTime @default(now())

  fallAlerts       FallAlert[] @relation("FallAlertDevice")

  @@index([patientId])
}

model EmergencyContact {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  patientId String
  patient   User     @relation(fields: [patientId], references: [id])

  confirmedAlerts FallAlert[] @relation("FallAlertConfirmedBy")

  priority  Int      @default(1)
}

model CaregiverPatient {
  id          String   @id @default(uuid())
  caregiverId String
  patientId   String
  createdAt   DateTime @default(now())

  caregiver User @relation("CaregiverPatients", fields: [caregiverId], references: [id])
  patient   User @relation("PatientCaregivers", fields: [patientId], references: [id])

  @@unique([caregiverId, patientId])
  @@index([patientId])
}

model FallAlert {
  id           String   @id @default(uuid())
  deviceId     String
  patientId    String

  device       Device   @relation("FallAlertDevice", fields: [deviceId], references: [id])
  patient      User     @relation("FallAlertPatient", fields: [patientId], references: [id])

  status       FallStatus
  latitude     Float
  longitude    Float
  createdAt    DateTime @default(now())
  confirmedAt  DateTime?
  location     String?

  confirmedByContactId String?
  confirmedBy          EmergencyContact? @relation("FallAlertConfirmedBy", fields: [confirmedByContactId], references: [id])

  confirmationMethod   ConfirmationMethod?

  // 🆕 Campos para rastreamento de resposta do cuidador
  respondedBy          String?  // UUID do cuidador que respondeu
  responder            User?    @relation("AlertRespondedBy", fields: [respondedBy], references: [id])
  respondedAt          DateTime?
  verificationDeadline DateTime? // Prazo para confirmar após "estou verificando"

  @@index([patientId, createdAt])
  @@index([respondedBy])
}

// Código de LOGIN simplificado para paciente e/ou de PAREAMENTO de device
model AccessCode {
  id            String   @id @default(uuid())

  codeDigest    String   @unique
  codeHash      String
  codeDisplay   String
  type          CodeType @default(LOGIN_PATIENT)

  caregiverId   String
  caregiver     User     @relation("IssuedByCaregiver", fields: [caregiverId], references: [id])

  patientId     String
  patient       User     @relation("LoginForPatient", fields: [patientId], references: [id])

  // 🆕 Dados para convite familiar
  familyEmail   String?  // Email do familiar a ser convidado
  familyName    String?  // Nome do familiar

  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  revokedById   String?

  maxUses       Int      @default(1)
  uses          Int      @default(0)
  attempts      Int      @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime @default(now())

  @@index([caregiverId])
  @@index([patientId])
  @@index([expiresAt])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  deviceId   String?
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

// 🆕 Nova tabela para hierarquia familiar
model FamilyRelation {
  id                 String   @id @default(uuid())
  primaryCaregiverId String   // Cuidador principal (quem criou)
  familyMemberId     String   // Familiar convidado
  patientId          String   // Paciente ao qual ambos têm acesso
  
  primaryCaregiver   User     @relation("PrimaryCaregiverRelations", fields: [primaryCaregiverId], references: [id])
  familyMember       User     @relation("FamilyMemberRelations", fields: [familyMemberId], references: [id])
  patient            User     @relation("PatientFamilyRelations", fields: [patientId], references: [id])
  
  permissions        FamilyPermissions?
  invitedAt          DateTime @default(now())
  acceptedAt         DateTime?
  revokedAt          DateTime?
  
  @@unique([primaryCaregiverId, familyMemberId, patientId])
  @@index([patientId])
  @@index([familyMemberId])
}

// 🆕 Sistema de permissões granular
model FamilyPermissions {
  id                String   @id @default(uuid())
  relationId        String   @unique
  relation          FamilyRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  
  canViewAlerts       Boolean @default(true)   // Ver alertas de queda
  canRespondAlerts    Boolean @default(false)  // Responder alertas
  canViewProfile      Boolean @default(true)   // Ver perfil do paciente
  canEditProfile      Boolean @default(false)  // Editar perfil
  canManageContacts   Boolean @default(false)  // Gerenciar contatos emergência
  canInviteFamily     Boolean @default(false)  // Convidar outros familiares
}

// =================== ENUMS ===================

enum Role {
  PATIENT
  CAREGIVER
  FAMILY_MEMBER  // 🆕 Novo role para familiares
}

enum FallStatus {
  PENDING        // Alerta criado, aguardando resposta do cuidador prioridade 1
  VERIFYING      // Cuidador indicou que está indo verificar
  FALSE_ALARM    // Cuidador marcou como falso alerta
  CONFIRMED      // Alerta confirmado (automaticamente ou manualmente)
  IGNORED        // Alerta ignorado/cancelado
  RESOLVED       // Alerta resolvido (após atendimento)
}

enum ConfirmationMethod {
  WHATSAPP
  APP
  CALL
  OTHER
}

enum CodeType {
  LOGIN_PATIENT
  DEVICE_PAIRING
  FAMILY_INVITE  // 🆕 Novo tipo para convite de familiares
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE 
  REVOKED
}
