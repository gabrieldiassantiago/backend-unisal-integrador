// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


enum Gender {
  MALE
  FEMALE
  OTHER
  UNDECLARED
}
// =================== MODELS ===================

model User {
  id         String   @id @default(uuid())
  name       String
  birthDate  DateTime?
  email      String?  @unique             // opcional (pacientes não precisam)
  password   String?                      // <-- opcional: paciente sem senha
  role       Role
  hasAccount Boolean  @default(false)
  createdAt  DateTime @default(now())
  gender     Gender?


  // relações
  devices       Device[]
  contacts      EmergencyContact[]
  patients      CaregiverPatient[] @relation("CaregiverPatients")   // pacientes deste cuidador
  caregivers    CaregiverPatient[] @relation("PatientCaregivers")   // cuidadores deste paciente
  fallAlerts    FallAlert[]        @relation("FallAlertPatient")

  // access codes
  issuedCodes   AccessCode[] @relation("IssuedByCaregiver")         // códigos emitidos por este cuidador
  loginCodes    AccessCode[] @relation("LoginForPatient")           // códigos destinados a este paciente

  // sessões
  refreshTokens RefreshToken[]

  @@index([role])
}

model Device {
  id               String   @id @default(uuid())
  deviceIdentifier String   @unique           // QR aponta pra isso ou para token
  apiKeyHash       String
  status           DeviceStatus @default(ACTIVE)
  
  // Pareamento por QR/token (opcional)
  pairingDigest    String?   @unique          // HMAC(token, secret)
  pairingExpiresAt DateTime?
  pairedAt         DateTime?

  // Telemetria / manutenção
  lastSeenAt       DateTime?
  firmwareVersion  String?

  // Dono (paciente)
  patientId        String?   // <- deixe opcional
  patient          User?      @relation(fields: [patientId], references: [id])
  registeredAt     DateTime @default(now())

  fallAlerts       FallAlert[] @relation("FallAlertDevice")

  @@index([patientId])
}

model EmergencyContact {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  patientId String
  patient   User     @relation(fields: [patientId], references: [id])

  // alerts que este contato confirmou
  confirmedAlerts FallAlert[] @relation("FallAlertConfirmedBy")

  priority  Int      @default(1)
}

model CaregiverPatient {
  id          String   @id @default(uuid())
  caregiverId String
  patientId   String
  createdAt   DateTime @default(now())

  caregiver User @relation("CaregiverPatients", fields: [caregiverId], references: [id])
  patient   User @relation("PatientCaregivers", fields: [patientId], references: [id])

  @@unique([caregiverId, patientId])
  @@index([patientId])
}

model FallAlert {
  id           String   @id @default(uuid())
  deviceId     String
  patientId    String

  device       Device   @relation("FallAlertDevice", fields: [deviceId], references: [id])
  patient      User     @relation("FallAlertPatient", fields: [patientId], references: [id])

  status       FallStatus
  latitude     Float
  longitude    Float
  createdAt    DateTime @default(now())
  confirmedAt  DateTime?
  location     String?

  confirmedByContactId String?
  confirmedBy          EmergencyContact? @relation("FallAlertConfirmedBy", fields: [confirmedByContactId], references: [id])

  confirmationMethod   ConfirmationMethod?

  @@index([patientId, createdAt])
}

// Código de LOGIN simplificado para paciente e/ou de PAREAMENTO de device
model AccessCode {
  id            String   @id @default(uuid())

  // segurança
  codeDigest    String   @unique    // HMAC(code, secret) -> lookup/indexável
  codeHash      String               // bcrypt(code) -> proteção em repouso
  codeDisplay   String               // ex.: "123-456" (apenas para exibir/log leve)
  type          CodeType @default(LOGIN_PATIENT)

  caregiverId   String
  caregiver     User     @relation("IssuedByCaregiver", fields: [caregiverId], references: [id])

  patientId     String
  patient       User     @relation("LoginForPatient", fields: [patientId], references: [id])

  // ciclo de vida
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  revokedById   String?             // opcional: quem revogou (cuidador/admin)

  // controle de uso
  maxUses       Int      @default(1)
  uses          Int      @default(0)
  attempts      Int      @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime @default(now())

  @@index([caregiverId])
  @@index([patientId])
  @@index([expiresAt])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  deviceId   String?              // identifica o aparelho (opcional)
  tokenHash  String   @unique     // hash do refresh token (nunca guarde em claro)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

// =================== ENUMS ===================

enum Role {
  PATIENT
  CAREGIVER
}

enum FallStatus {
  PENDING
  CONFIRMED
  IGNORED
}

enum ConfirmationMethod {
  WHATSAPP
  APP
  CALL
  OTHER
}

enum CodeType {
  LOGIN_PATIENT
  DEVICE_PAIRING
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  REVOKED
}
